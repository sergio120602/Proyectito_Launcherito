<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- La versión de Windows hace falta para el vídeo de YouTube dentro de las portadas (WebView2CompositionControl) -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.10.1</Version>
    <Product>Launcherito</Product>
    <AssemblyTitle>Launcherito</AssemblyTitle>
    <!-- Logo del programa: icono del .exe, de la barra de tareas y de la ventana -->
    <ApplicationIcon>Launcherito.ico</ApplicationIcon>

    <!-- Publicación como un único .exe que no necesita tener .NET instalado -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sin compresión: el .exe pesa más en disco, pero no descomprime .NET en la RAM al arrancar (~90 MB menos) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Launcherito.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
