<Window x:Class="Launcherito.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launcherito"
        Title="Launcherito" Icon="Launcherito.ico" Width="1000" Height="760" MinWidth="460" MinHeight="600"
        Background="Black" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#A78BFA"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="Track" Color="#2A2A2A"/>

        <!-- Botón grande y redondeado -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="48,22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón grande oscuro de la pantalla inicial (Tus canciones, Borrar canciones) -->
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="32,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón rojo para confirmar el borrado -->
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila con casilla (Borrar canciones en rojo; Añadir canciones a una playlist en morado).
             El color de la casilla marcada es el Background del CheckBox. -->
        <Style x:Key="SongCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="2"
                                        BorderBrush="#555555" Background="Transparent" VerticalAlignment="Center">
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="11" Foreground="White" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Corazón de Favoritos -->
        <SolidColorBrush x:Key="FavoritePink" Color="#F472B6"/>

        <!-- Menú oscuro (clic derecho en una canción y botón ＋ de los controles): Favoritos y playlists -->
        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="10"
                                Padding="6" MinWidth="220">
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource Accent}" Visibility="Collapsed"
                                                   VerticalAlignment="Center"/>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Background="#333333" Margin="6,5"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Buscador con forma de píldora: lupa, texto de ayuda (Tag) mientras está vacío y X para borrarlo -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                BorderThickness="1" BorderBrush="Transparent" Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Grid.Column="1" Margin="10,0,0,0" Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262626"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón circular de reproducir / pausar -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de icono (anterior, siguiente, aleatorio) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón con forma de píldora (cambio de vista) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Píldora de color fijo (Editar en morado, Dejar edición en verde): al pasar el ratón se aclara. -->
        <SolidColorBrush x:Key="EditGreen" Color="#22C55E"/>
        <Style x:Key="ColorPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pestaña de la barra superior (Canciones / Artistas / Géneros). Tag="Active" la resalta. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de artista o género: sin marco de botón, se aclara al pasar el ratón -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de canción en el detalle de un artista o género -->
        <Style x:Key="SongRowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón verde de Spotify (pantalla inicial y panel del enlace) -->
        <SolidColorBrush x:Key="SpotifyGreen" Color="#1DB954"/>
        <Style x:Key="SpotifyButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="{StaticResource SpotifyGreen}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1ED760"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón rojo de YouTube Music (pantalla inicial y panel del enlace) -->
        <SolidColorBrush x:Key="YouTubeMusicRed" Color="#FF0033"/>
        <Style x:Key="YouTubeMusicButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource YouTubeMusicRed}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3355"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de texto discreto -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- X redonda para cerrar el vídeo de YouTube de una portada -->
        <Style x:Key="VideoCloseButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#B3000000"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Barra deslizante -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekBar" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Sin foco de teclado: las flechas movían la barra sin cambiar la posición de la canción. -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- El fondo transparente hace que toda la franja responda al clic, no solo la línea de 5 px. -->
                        <Grid Height="28" Background="Transparent">
                            <Border Height="5" CornerRadius="3" Background="{StaticResource Track}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{StaticResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Hueco invisible para el vídeo de las canciones de Spotify y YouTube Music fuera de la vista original: se
             oye pero no se ve. Va fuera del reproductor para que siga sonando (y con tamaño) también
             en el menú principal; YouTube pide al menos 200 px de alto para reproducir. -->
        <Border x:Name="HiddenVideoHost" Width="400" Height="225" Opacity="0" IsHitTestVisible="False"
                Panel.ZIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

        <!-- Pantalla inicial: canciones del PC, las guardadas, borrarlas o una lista de Spotify o YouTube Music -->
        <StackPanel x:Name="StartPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BackToPlayerButton" Style="{StaticResource SpotifyButton}" Margin="0,0,0,22"
                    HorizontalAlignment="Center" Visibility="Collapsed" Click="BackToPlayerButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BackToPlayerText" Text="Volver al reproductor" Margin="10,0,0,0" VerticalAlignment="Center"
                               MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <!-- Barra de búsqueda de YouTube: Enter abre el panel con los resultados -->
            <TextBox x:Name="StartYouTubeBox" Style="{StaticResource SearchBox}" Width="420" FontSize="15" Margin="0,0,0,22"
                     Tag="Buscar canciones en YouTube…" AutomationProperties.Name="Buscar canciones en YouTube"
                     ToolTip="Escribe una canción o un artista, o pega el enlace de un vídeo, y pulsa Enter"
                     KeyDown="StartYouTubeBox_KeyDown"/>
            <Button Content="Cargar Archivos" Style="{StaticResource BigButton}" Click="LoadButton_Click"/>
            <Button x:Name="LibraryButton" Style="{StaticResource StartButton}" Margin="0,16,0,0"
                    AutomationProperties.Name="Tus canciones" Click="LibraryButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock Text="Tus canciones" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LibraryCountText" Margin="10,0,0,0" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="DeleteSongsButton" Style="{StaticResource StartButton}" Margin="0,12,0,0"
                    AutomationProperties.Name="Borrar canciones" Click="DeleteSongsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock Text="Borrar canciones" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="StartPlaylistsButton" Style="{StaticResource StartButton}" Margin="0,12,0,0"
                    AutomationProperties.Name="Tus playlists" Click="StartPlaylistsButton_Click"
                    ToolTip="Favoritos y las playlists que hayas hecho">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEB52;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"
                               Foreground="{StaticResource FavoritePink}"/>
                    <TextBlock Text="Tus playlists" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlaylistsCountText" Margin="10,0,0,0" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StartButton}" Margin="0,12,0,0"
                    AutomationProperties.Name="Del momento" Click="StartTrendingButton_Click"
                    ToolTip="Las playlists más escuchadas de Spotify, renovadas cada día a las 7:00">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"
                               Foreground="{StaticResource SpotifyGreen}"/>
                    <TextBlock Text="Del momento" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SpotifyButton}" Margin="0,22,0,0" HorizontalAlignment="Center"
                    AutomationProperties.Name="Añadir lista de Spotify"
                    Click="SpotifyButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock Text="Añadir lista de Spotify" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource YouTubeMusicButton}" Margin="0,12,0,0" HorizontalAlignment="Center"
                    AutomationProperties.Name="Añadir lista de YouTube Music"
                    Click="YouTubeMusicButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock Text="Añadir lista de YouTube Music" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Margin="0,18,0,0" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                       Text="Las canciones que cargues se guardan solas en «Tus canciones»."/>

            <!-- Actualizar: la versión abierta y el botón para buscar o instalar una más nueva (MainWindow.Update.cs) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button x:Name="UpdateButton" Style="{StaticResource LinkButton}" Margin="12,0,0,0" FontSize="13"
                        VerticalAlignment="Center" Click="UpdateButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UpdateButtonText" Text="Buscar actualizaciones" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="InstallUpdateButton" Style="{StaticResource ColorPillButton}" Background="{StaticResource Accent}"
                    HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" Click="UpdateButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InstallUpdateText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="UpdateStatusText" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Reproductor -->
        <Grid x:Name="PlayerPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra superior. Arriba: inicio, pestañas | buscador | editar y cambio de vista.
                 Abajo: añadir canciones, Tus canciones, borrar y estado. -->
            <Grid Grid.Row="0" Margin="20,14,20,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HomeButton" Style="{StaticResource PillButton}" Margin="0,0,10,0"
                            ToolTip="Volver al menú principal (la música sigue sonando)" Click="HomeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Inicio" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SongsTab" Style="{StaticResource TabButton}" Content="Canciones" Click="SongsTab_Click"/>
                    <Button x:Name="ArtistsTab" Style="{StaticResource TabButton}" Content="Artistas" Click="ArtistsTab_Click"/>
                    <Button x:Name="GenresTab" Style="{StaticResource TabButton}" Content="Géneros" Click="GenresTab_Click"/>
                    <Button x:Name="PlaylistsTab" Style="{StaticResource TabButton}" Content="Playlists" Click="PlaylistsTab_Click"
                            ToolTip="Favoritos y tus playlists"/>
                    <Button x:Name="TrendingTab" Style="{StaticResource TabButton}" Content="Del momento" Click="TrendingTab_Click"
                            ToolTip="Las playlists más escuchadas de Spotify, renovadas cada día a las 7:00"/>
                </StackPanel>

                <!-- Buscador: las coincidencias salen en una lista debajo; al pulsar una, suena -->
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Buscar canción…"
                         HorizontalAlignment="Right" Width="300" MinWidth="120" Margin="16,0,10,0"
                         AutomationProperties.Name="Buscar canción" ToolTip="Buscar por el nombre de la canción (Ctrl+F)"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         GotKeyboardFocus="SearchBox_GotKeyboardFocus"/>
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                       VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#161616" CornerRadius="14" Padding="6" Width="420"
                            BorderBrush="#2A2A2A" BorderThickness="1">
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SearchResults"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Modo edición del mosaico: Editar se queda en morado mientras está activo y aparece Dejar edición en verde -->
                    <Button x:Name="EditButton" Style="{StaticResource ColorPillButton}" Background="#1C1C1C"
                            Margin="0,0,8,0" Click="EditButton_Click"
                            ToolTip="Mover las portadas y cambiar su tamaño">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Editar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopEditButton" Style="{StaticResource ColorPillButton}"
                            Background="{StaticResource EditGreen}" Visibility="Collapsed"
                            Margin="0,0,8,0" Click="StopEditButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dejar edición" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewToggleButton" Style="{StaticResource PillButton}"
                            Click="ViewToggleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ViewToggleIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ViewToggleText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4,10,0,0">
                    <Button Style="{StaticResource LinkButton}" Content="＋  Añadir canciones" Click="LoadButton_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="＋  Lista de Spotify" Margin="16,0,0,0"
                            Click="SpotifyButton_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="＋  Lista de YouTube Music" Margin="16,0,0,0"
                            Click="YouTubeMusicButton_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="＋  Desde YouTube" Margin="16,0,0,0"
                            ToolTip="Buscar canciones en YouTube y añadirlas a tus canciones" Click="YouTubeSearchButton_Click"/>
                    <!-- Solo se ve si hay canciones guardadas que no están cargadas -->
                    <Button x:Name="TopLibraryButton" Style="{StaticResource LinkButton}" Margin="16,0,0,0"
                            Visibility="Collapsed" Click="LibraryButton_Click"/>
                    <Button x:Name="TopDeleteButton" Style="{StaticResource LinkButton}" Content="Borrar"
                            ToolTip="Borrar canciones de «Tus canciones»" AutomationProperties.Name="Borrar canciones"
                            Margin="16,0,0,0" Visibility="Collapsed" Click="DeleteSongsButton_Click"/>
                    <TextBlock x:Name="SongCountText" FontSize="13" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
                    <!-- Solo si hay una versión nueva: lleva al mismo botón que la pantalla inicial -->
                    <Button x:Name="TopUpdateButton" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Visibility="Collapsed"
                            Foreground="{StaticResource Accent}" Click="UpdateButton_Click"/>
                    <!-- Mientras suena una playlist: su nombre y la vuelta a todas las canciones -->
                    <StackPanel x:Name="SessionPanel" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="SessionText" FontSize="13" Foreground="{StaticResource Accent}"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource LinkButton}" Content="Ver todas" Margin="10,0,0,0"
                                ToolTip="Volver a tener todas tus canciones en el mosaico (la que suena sigue sonando)"
                                Click="LeaveSession_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ListStatusText" FontSize="13" Foreground="{StaticResource SpotifyGreen}" Margin="16,0,0,0"/>
                    <TextBlock x:Name="CatalogStatusText" FontSize="13" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Vista mosaico: todas las canciones -->
            <ScrollViewer x:Name="MosaicView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" ScrollChanged="MosaicView_ScrollChanged">
                <local:MosaicPanel x:Name="Mosaic" Margin="20,8,20,20"/>
            </ScrollViewer>

            <!-- Vista de artistas o géneros: tarjetas con foto, o las canciones de una de ellas -->
            <Grid x:Name="CategoryView" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera del detalle: volver | foto | nombre -->
                <Grid x:Name="CategoryHeader" Margin="20,6,20,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource LinkButton}" Content="‹  Volver" FontSize="14" VerticalAlignment="Center"
                            Click="CategoryBack_Click"/>
                    <Border x:Name="CategoryHeaderPictureHost" Grid.Column="1" Margin="20,0,16,0"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CategoryTitleText" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CategorySubtitleText" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <!-- Solo en el detalle de una playlist del momento -->
                        <WrapPanel x:Name="TrendingActions" Margin="0,10,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource ColorPillButton}" Background="{StaticResource Accent}" Margin="0,0,8,6"
                                    Click="PlayTrending_Click" ToolTip="Escuchar esta playlist (cada canción con su vídeo de YouTube)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reproducir" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButton}" Margin="0,0,8,6" Click="SaveTrending_Click"
                                    ToolTip="Copiarla tal como está hoy a tus playlists (y sus canciones a «Tus canciones»)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Guardar en mis playlists" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButton}" Margin="0,0,8,6" Click="OpenTrendingInSpotify_Click"
                                    ToolTip="Abrir la playlist en Spotify">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource SpotifyGreen}"/>
                                    <TextBlock Text="Ver en Spotify" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <!-- Solo en el detalle de una playlist -->
                        <WrapPanel x:Name="PlaylistActions" Margin="0,10,0,0" Visibility="Collapsed">
                            <Button x:Name="PlayListButton" Style="{StaticResource ColorPillButton}"
                                    Background="{StaticResource Accent}" Margin="0,0,8,6" Click="PlayListButton_Click"
                                    ToolTip="Escuchar solo las canciones de esta playlist">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reproducir" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButton}" Margin="0,0,8,6" Click="AddSongsToList_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Añadir canciones" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Vista de la playlist: lista sencilla o mosaico de portadas (muestra a la que se cambia) -->
                            <Button x:Name="ListViewToggleButton" Style="{StaticResource PillButton}" Margin="0,0,8,6"
                                    Click="ListViewToggle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ListViewToggleIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ListViewToggleText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Solo en el mosaico: mover y agrandar portadas; en verde mientras se edita -->
                            <Button x:Name="ListEditButton" Style="{StaticResource ColorPillButton}" Background="#1C1C1C"
                                    Margin="0,0,8,6" Click="ListEdit_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ListEditIcon" Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ListEditText" Text="Editar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RenameListButton" Style="{StaticResource PillButton}" Margin="0,0,8,6"
                                    Click="RenameList_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Renombrar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteListButton" Style="{StaticResource PillButton}" Margin="0,0,8,6"
                                    Click="DeleteList_Click" ToolTip="Las canciones no se borran de «Tus canciones»">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource DangerRed}"/>
                                    <TextBlock Text="Borrar playlist" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="CategoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" ScrollChanged="CategoryScroll_ScrollChanged">
                    <StackPanel Margin="20,8,20,20">
                        <!-- Del momento: de dónde salen, cuándo se actualizaron y «Actualizar ahora» -->
                        <StackPanel x:Name="TrendingInfo" Orientation="Horizontal" Margin="0,0,0,18" Visibility="Collapsed">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource SpotifyGreen}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TrendingStatusText" FontSize="13" Foreground="{StaticResource Muted}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="TrendingRefreshButton" Style="{StaticResource LinkButton}" Content="Actualizar ahora"
                                    Margin="16,0,0,0" VerticalAlignment="Center" Click="TrendingRefresh_Click"/>
                        </StackPanel>
                        <WrapPanel x:Name="CardsPanel"/>
                        <StackPanel x:Name="SongListPanel" Visibility="Collapsed"/>
                        <!-- Una playlist en vista mosaico: sus portadas, que se mueven y agrandan con «Editar» -->
                        <local:MosaicPanel x:Name="PlaylistMosaic" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Vista original: una canción -->
            <Grid x:Name="SingleView" Grid.Row="1" Margin="36,8,36,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Carátula cuadrada que se adapta al tamaño de la ventana. Encima, el vídeo de YouTube de la
                     canción, manejado con los controles de abajo; mientras se ve, el marco pasa a 16:9. -->
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" MaxWidth="560">
                    <Border x:Name="CoverFrame" Width="400" Height="400" CornerRadius="16" Background="#151515">
                        <Grid>
                            <TextBlock x:Name="CoverPlaceholder" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="120" Foreground="#3A3A3A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="SongVideoHost" Opacity="0" IsHitTestVisible="False"
                                    SizeChanged="SongVideoHost_SizeChanged"/>
                            <Border x:Name="SongVideoStatus" Visibility="Collapsed" Background="#CC000000" CornerRadius="12"
                                    Padding="12,6" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <TextBlock x:Name="SongVideoStatusText" FontSize="12" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>

                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ArtistText" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Barra y botones: un único juego de controles que se mueve entre esta vista y la
                     portada activa del mosaico (MainWindow.MoveControls). -->
                <Border x:Name="OriginalControlsHost" Grid.Row="2" Margin="0,22,0,0" MaxWidth="560">
                    <StackPanel x:Name="ControlsPanel">
                        <Slider x:Name="SeekSlider" Style="{StaticResource SeekBar}" Minimum="0" Maximum="1"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="SeekSlider_LostMouseCapture"
                                ValueChanged="SeekSlider_ValueChanged"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="TotalTimeText" Text="0:00" FontSize="12" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Controles: favorito, aleatorio | anterior | reproducir/pausar | siguiente | añadir a playlist, posición -->
                        <Grid Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Width="44" Height="44"
                                        FontSize="18" Content="&#xEB51;" Click="FavoriteButton_Click"/>
                                <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" FontSize="18"
                                        Content="&#xE8B1;" Click="ShuffleButton_Click"/>
                            </StackPanel>
                            <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="0,0,12,0"
                                    Content="&#xE892;" ToolTip="Canción anterior" Click="PreviousButton_Click"/>
                            <Button x:Name="PlayPauseButton" Grid.Column="2" Style="{StaticResource RoundButton}"
                                    Content="&#xE768;" ToolTip="Reproducir / Pausar" Click="PlayPauseButton_Click"/>
                            <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource IconButton}" Margin="12,0,0,0"
                                    Content="&#xE893;" ToolTip="Canción siguiente" Click="NextButton_Click"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="AddToListButton" Style="{StaticResource IconButton}" Width="44" Height="44"
                                        FontSize="18" Content="&#xE710;" Foreground="{StaticResource Muted}"
                                        ToolTip="Añadir a una playlist" Click="AddToListButton_Click"/>
                                <TextBlock x:Name="PositionText" FontSize="12" Foreground="{StaticResource Muted}"
                                           MinWidth="44" TextAlignment="Center"
                                           VerticalAlignment="Center" ToolTip="Posición en la lista"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Barra de reproducción de abajo. Siempre en Artistas, Géneros y Playlists; en el mosaico,
                 solo cuando la portada que suena (con sus controles) se ha perdido de vista al desplazarse.
                 Los controles son los mismos que van dentro de la portada: se mueven aquí (MoveControls). -->
            <Border x:Name="PlayerBar" Grid.Row="2" Background="#0E0E0E" Padding="20,10,20,8"
                    BorderBrush="#222222" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- En el mosaico, pulsar el título lleva a la portada que suena -->
                    <StackPanel x:Name="BarSongInfo" VerticalAlignment="Center" Margin="0,0,16,0" Background="Transparent"
                                MouseLeftButtonUp="BarSongInfo_MouseLeftButtonUp">
                        <TextBlock x:Name="BarTitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BarArtistText" FontSize="12" Foreground="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border x:Name="BarControlsHost" Grid.Column="1" Width="520"/>
                    <Button x:Name="GoToSongButton" Grid.Column="2" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                            ToolTip="Volver a la portada de la canción que suena" Click="GoToSongButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Ir a la canción" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Panel para pegar el enlace de una lista de Spotify o YouTube Music, por encima de todo.
             El título, la explicación y el color del botón cambian según el botón con que se abre;
             el enlace puede ser de cualquiera de los dos. -->
        <Grid x:Name="ListOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#161616" CornerRadius="18" Padding="28,24" Margin="20"
                    MaxWidth="560" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ListDialogTitle" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ListDialogHelp" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="ListLinkBox" Margin="0,18,0,0" Padding="10,8" FontSize="14"
                             Background="#0E0E0E" Foreground="White" CaretBrush="White" BorderBrush="#333333"
                             KeyDown="ListLinkBox_KeyDown"/>
                    <TextBlock x:Name="ListDialogStatus" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Cancelar" FontSize="14" VerticalAlignment="Center"
                                Click="ListCancel_Click"/>
                        <Button x:Name="ListAddButton" Style="{StaticResource SpotifyButton}" Content="Añadir"
                                Margin="22,0,0,0" Click="ListAdd_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Panel Borrar canciones: se eligen con casillas las guardadas que se quitan -->
        <Grid x:Name="DeleteOverlay" Background="#CC000000" Visibility="Collapsed" Focusable="True" KeyDown="DeleteOverlay_KeyDown">
            <Border Background="#161616" CornerRadius="18" Padding="28,24" Margin="20"
                    MaxWidth="620" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Borrar canciones" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Marca las que quieras quitar de «Tus canciones». Los archivos .mp3 de tu PC no se borran: puedes volver a cargarlos cuando quieras."/>
                    <Button x:Name="SelectAllButton" Grid.Row="2" Style="{StaticResource LinkButton}" Margin="12,16,0,6"
                            HorizontalAlignment="Left" Click="SelectAllButton_Click"/>
                    <ScrollViewer Grid.Row="3" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DeleteList"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Cancelar" FontSize="14" VerticalAlignment="Center"
                                Click="DeleteCancel_Click"/>
                        <Button x:Name="ConfirmDeleteButton" Style="{StaticResource DangerButton}"
                                Margin="22,0,0,0" Click="ConfirmDelete_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Panel Añadir canciones a una playlist: se marcan con casillas entre las de «Tus canciones» -->
        <Grid x:Name="PickOverlay" Background="#CC000000" Visibility="Collapsed" Focusable="True" KeyDown="PickOverlay_KeyDown">
            <Border Background="#161616" CornerRadius="18" Padding="28,24" Margin="20"
                    MaxWidth="620" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PickTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Marca las canciones de «Tus canciones» que quieras añadir. Se ponen al final de la playlist."/>
                    <TextBox x:Name="PickFilterBox" Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource SearchBox}"
                             Tag="Filtrar por canción o artista…" AutomationProperties.Name="Filtrar canciones"
                             TextChanged="PickFilterBox_TextChanged"/>
                    <Button x:Name="PickAllButton" Grid.Row="3" Style="{StaticResource LinkButton}" Margin="12,14,0,6"
                            HorizontalAlignment="Left" Click="PickAllButton_Click"/>
                    <ScrollViewer x:Name="PickScroll" Grid.Row="4" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PickList"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Cancelar" FontSize="14" VerticalAlignment="Center"
                                Click="PickCancel_Click"/>
                        <Button x:Name="ConfirmPickButton" Style="{StaticResource ColorPillButton}"
                                Background="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold" Padding="22,10"
                                Margin="22,0,0,0" Click="ConfirmPick_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Panel Buscar en YouTube: canciones o vídeos (o el enlace de un vídeo) que se añaden a «Tus canciones» -->
        <Grid x:Name="YouTubeOverlay" Background="#CC000000" Visibility="Collapsed" Focusable="True"
              KeyDown="YouTubeOverlay_KeyDown">
            <Border Background="#161616" CornerRadius="18" Padding="28,24" Margin="20"
                    MaxWidth="720" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource YouTubeMusicRed}" VerticalAlignment="Center"/>
                        <TextBlock Text="Buscar en YouTube" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Busca una canción o un artista, o pega el enlace de un vídeo. Las que añadas se quedan en «Tus canciones» y suenan con su vídeo de YouTube, como las de YouTube Music."/>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="YouTubeQueryBox" Style="{StaticResource SearchBox}" FontSize="14"
                                 Tag="Canción, artista o enlace de YouTube…" AutomationProperties.Name="Buscar en YouTube"
                                 KeyDown="YouTubeQueryBox_KeyDown"/>
                        <Button x:Name="YouTubeSearchGo" Grid.Column="1" Style="{StaticResource YouTubeMusicButton}"
                                Content="Buscar" Margin="10,0,0,0" Click="YouTubeSearchGo_Click"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="YouTubeSongsTab" Style="{StaticResource TabButton}" Content="Canciones" Tag="Active"
                                ToolTip="Canciones de álbumes, con su portada" Click="YouTubeSongsTab_Click"/>
                        <Button x:Name="YouTubeVideosTab" Style="{StaticResource TabButton}" Content="Vídeos"
                                ToolTip="Videoclips, directos, versiones…" Click="YouTubeVideosTab_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="YouTubeStatus" Grid.Row="4" Margin="4,10,0,4" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"/>
                    <ScrollViewer x:Name="YouTubeScroll" Grid.Row="5" MaxHeight="430" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="YouTubeResults"/>
                    </ScrollViewer>
                    <Button Grid.Row="6" Style="{StaticResource LinkButton}" Content="Cerrar" FontSize="14"
                            HorizontalAlignment="Right" Margin="0,16,0,0" Click="YouTubeClose_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Panel para poner nombre a una playlist nueva o cambiárselo a una que ya existe -->
        <Grid x:Name="NameOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#161616" CornerRadius="18" Padding="28,24" Margin="20"
                    MaxWidth="480" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="NameDialogTitle" FontSize="22" FontWeight="SemiBold"/>
                    <TextBox x:Name="NameBox" Margin="0,18,0,0" Padding="10,8" FontSize="14" MaxLength="60"
                             Background="#0E0E0E" Foreground="White" CaretBrush="White" BorderBrush="#333333"
                             AutomationProperties.Name="Nombre de la playlist" KeyDown="NameBox_KeyDown"/>
                    <TextBlock x:Name="NameDialogStatus" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerRed}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Cancelar" FontSize="14" VerticalAlignment="Center"
                                Click="NameCancel_Click"/>
                        <Button x:Name="NameSaveButton" Style="{StaticResource ColorPillButton}"
                                Background="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold" Padding="22,10"
                                Margin="22,0,0,0" Click="NameSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
