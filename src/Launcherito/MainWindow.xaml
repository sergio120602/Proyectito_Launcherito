<Window x:Class="Launcherito.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launcherito"
        Title="Launcherito" Icon="Launcherito.ico" Width="1000" Height="760" MinWidth="460" MinHeight="600"
        Background="Black" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#A78BFA"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="Track" Color="#2A2A2A"/>

        <!-- Botón grande y redondeado -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="48,22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón grande oscuro de la pantalla inicial (Tus canciones, Borrar canciones) -->
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="32,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón rojo para confirmar el borrado -->
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila con casilla del panel Borrar canciones -->
        <Style x:Key="SongCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="2"
                                        BorderBrush="#555555" Background="Transparent" VerticalAlignment="Center">
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="11" Foreground="White" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource DangerRed}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DangerRed}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón circular de reproducir / pausar -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de icono (anterior, siguiente, aleatorio) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón con forma de píldora (cambio de vista) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Píldora de color fijo (Editar en morado, Dejar edición en verde): al pasar el ratón se aclara. -->
        <SolidColorBrush x:Key="EditGreen" Color="#22C55E"/>
        <Style x:Key="ColorPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pestaña de la barra superior (Canciones / Artistas / Géneros). Tag="Active" la resalta. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de artista o género: sin marco de botón, se aclara al pasar el ratón -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de canción en el detalle de un artista o género -->
        <Style x:Key="SongRowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón verde de Spotify (pantalla inicial y panel del enlace) -->
        <SolidColorBrush x:Key="SpotifyGreen" Color="#1DB954"/>
        <Style x:Key="SpotifyButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="{StaticResource SpotifyGreen}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1ED760"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de texto discreto -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- X redonda para cerrar el vídeo de YouTube de una portada -->
        <Style x:Key="VideoCloseButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#B3000000"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Barra deslizante -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekBar" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Sin foco de teclado: las flechas movían la barra sin cambiar la posición de la canción. -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- El fondo transparente hace que toda la franja responda al clic, no solo la línea de 5 px. -->
                        <Grid Height="28" Background="Transparent">
                            <Border Height="5" CornerRadius="3" Background="{StaticResource Track}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{StaticResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Pantalla inicial: canciones del PC, las guardadas, borrarlas o una lista de Spotify -->
        <StackPanel x:Name="StartPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Cargar Archivos" Style="{StaticResource BigButton}" Click="LoadButton_Click"/>
            <Button x:Name="LibraryButton" Style="{StaticResource StartButton}" Margin="0,16,0,0"
                    AutomationProperties.Name="Tus canciones" Click="LibraryButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock Text="Tus canciones" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LibraryCountText" Margin="10,0,0,0" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="DeleteSongsButton" Style="{StaticResource StartButton}" Margin="0,12,0,0"
                    AutomationProperties.Name="Borrar canciones" Click="DeleteSongsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock Text="Borrar canciones" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SpotifyButton}" Margin="0,22,0,0" HorizontalAlignment="Center"
                    AutomationProperties.Name="Añadir lista de Spotify"
                    Click="SpotifyButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock Text="Añadir lista de Spotify" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Margin="0,18,0,0" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                       Text="Las canciones que cargues se guardan solas en «Tus canciones»."/>
        </StackPanel>

        <!-- Reproductor -->
        <Grid x:Name="PlayerPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior: pestañas | añadir canciones y estado | cambio de vista -->
            <Grid Grid.Row="0" Margin="20,14,20,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SongsTab" Style="{StaticResource TabButton}" Content="Canciones" Click="SongsTab_Click"/>
                    <Button x:Name="ArtistsTab" Style="{StaticResource TabButton}" Content="Artistas" Click="ArtistsTab_Click"/>
                    <Button x:Name="GenresTab" Style="{StaticResource TabButton}" Content="Géneros" Click="GenresTab_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0">
                    <Button Style="{StaticResource LinkButton}" Content="＋  Añadir canciones" Click="LoadButton_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="＋  Lista de Spotify" Margin="16,0,0,0"
                            Click="SpotifyButton_Click"/>
                    <!-- Solo se ve si hay canciones guardadas que no están cargadas -->
                    <Button x:Name="TopLibraryButton" Style="{StaticResource LinkButton}" Margin="16,0,0,0"
                            Visibility="Collapsed" Click="LibraryButton_Click"/>
                    <Button x:Name="TopDeleteButton" Style="{StaticResource LinkButton}" Content="Borrar"
                            ToolTip="Borrar canciones de «Tus canciones»" AutomationProperties.Name="Borrar canciones"
                            Margin="16,0,0,0" Visibility="Collapsed" Click="DeleteSongsButton_Click"/>
                    <TextBlock x:Name="SongCountText" FontSize="13" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
                    <TextBlock x:Name="SpotifyStatusText" FontSize="13" Foreground="{StaticResource SpotifyGreen}" Margin="16,0,0,0"/>
                    <TextBlock x:Name="CatalogStatusText" FontSize="13" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Modo edición del mosaico: Editar se queda en morado mientras está activo y aparece Dejar edición en verde -->
                    <Button x:Name="EditButton" Style="{StaticResource ColorPillButton}" Background="#1C1C1C"
                            Margin="0,0,8,0" Click="EditButton_Click"
                            ToolTip="Mover las portadas y cambiar su tamaño">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Editar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopEditButton" Style="{StaticResource ColorPillButton}"
                            Background="{StaticResource EditGreen}" Visibility="Collapsed"
                            Margin="0,0,8,0" Click="StopEditButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dejar edición" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewToggleButton" Style="{StaticResource PillButton}"
                            Click="ViewToggleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ViewToggleIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ViewToggleText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Vista mosaico: todas las canciones -->
            <ScrollViewer x:Name="MosaicView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" ScrollChanged="MosaicView_ScrollChanged">
                <local:MosaicPanel x:Name="Mosaic" Margin="20,8,20,20"/>
            </ScrollViewer>

            <!-- Vista de artistas o géneros: tarjetas con foto, o las canciones de una de ellas -->
            <Grid x:Name="CategoryView" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera del detalle: volver | foto | nombre -->
                <Grid x:Name="CategoryHeader" Margin="20,6,20,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource LinkButton}" Content="‹  Volver" FontSize="14" VerticalAlignment="Center"
                            Click="CategoryBack_Click"/>
                    <Border x:Name="CategoryHeaderPictureHost" Grid.Column="1" Margin="20,0,16,0"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CategoryTitleText" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CategorySubtitleText" FontSize="13" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="CategoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,8,20,20">
                        <WrapPanel x:Name="CardsPanel"/>
                        <StackPanel x:Name="SongListPanel" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Reproductor en la parte de abajo mientras se navega por artistas y géneros -->
                <Border Grid.Row="2" Background="#0E0E0E" Padding="20,10,20,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="BarTitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="BarArtistText" FontSize="12" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="BarControlsHost" Grid.Column="1" Width="520"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Vista original: una canción -->
            <Grid x:Name="SingleView" Grid.Row="1" Margin="36,8,36,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Carátula cuadrada que se adapta al tamaño de la ventana -->
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" MaxWidth="560">
                    <Border Width="400" Height="400" CornerRadius="16" Background="#151515">
                        <Grid>
                            <TextBlock x:Name="CoverPlaceholder" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="120" Foreground="#3A3A3A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>

                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ArtistText" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Barra y botones: un único juego de controles que se mueve entre esta vista y la
                     portada activa del mosaico (MainWindow.MoveControls). -->
                <Border x:Name="OriginalControlsHost" Grid.Row="2" Margin="0,22,0,0" MaxWidth="560">
                    <StackPanel x:Name="ControlsPanel">
                        <Slider x:Name="SeekSlider" Style="{StaticResource SeekBar}" Minimum="0" Maximum="1"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="SeekSlider_LostMouseCapture"
                                ValueChanged="SeekSlider_ValueChanged"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="TotalTimeText" Text="0:00" FontSize="12" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Controles: aleatorio | anterior | reproducir/pausar | siguiente | posición en la lista -->
                        <Grid Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ShuffleButton" Grid.Column="0" Style="{StaticResource IconButton}" FontSize="18"
                                    Content="&#xE8B1;" Click="ShuffleButton_Click"/>
                            <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="0,0,12,0"
                                    Content="&#xE892;" ToolTip="Canción anterior" Click="PreviousButton_Click"/>
                            <Button x:Name="PlayPauseButton" Grid.Column="2" Style="{StaticResource RoundButton}"
                                    Content="&#xE768;" ToolTip="Reproducir / Pausar" Click="PlayPauseButton_Click"/>
                            <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource IconButton}" Margin="12,0,0,0"
                                    Content="&#xE893;" ToolTip="Canción siguiente" Click="NextButton_Click"/>
                            <TextBlock x:Name="PositionText" Grid.Column="4" FontSize="12" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Posición en la lista"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Panel para pegar el enlace de una lista de Spotify, por encima de todo -->
        <Grid x:Name="SpotifyOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#161616" CornerRadius="18" Padding="28,24" Margin="20"
                    MaxWidth="560" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Añadir lista de Spotify" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Pega el enlace de una lista pública o de un álbum (Compartir → Copiar enlace). Se cargan hasta 100 canciones con su portada. Las que ya tengas en .mp3 suenan enteras; las demás, al pulsarlas, abren su vídeo en YouTube."/>
                    <TextBox x:Name="SpotifyLinkBox" Margin="0,18,0,0" Padding="10,8" FontSize="14"
                             Background="#0E0E0E" Foreground="White" CaretBrush="White" BorderBrush="#333333"
                             KeyDown="SpotifyLinkBox_KeyDown"/>
                    <TextBlock x:Name="SpotifyDialogStatus" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Cancelar" FontSize="14" VerticalAlignment="Center"
                                Click="SpotifyCancel_Click"/>
                        <Button x:Name="SpotifyAddButton" Style="{StaticResource SpotifyButton}" Content="Añadir"
                                Margin="22,0,0,0" Click="SpotifyAdd_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Panel Borrar canciones: se eligen con casillas las guardadas que se quitan -->
        <Grid x:Name="DeleteOverlay" Background="#CC000000" Visibility="Collapsed" Focusable="True" KeyDown="DeleteOverlay_KeyDown">
            <Border Background="#161616" CornerRadius="18" Padding="28,24" Margin="20"
                    MaxWidth="620" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Borrar canciones" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Marca las que quieras quitar de «Tus canciones». Los archivos .mp3 de tu PC no se borran: puedes volver a cargarlos cuando quieras."/>
                    <Button x:Name="SelectAllButton" Grid.Row="2" Style="{StaticResource LinkButton}" Margin="12,16,0,6"
                            HorizontalAlignment="Left" Click="SelectAllButton_Click"/>
                    <ScrollViewer Grid.Row="3" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DeleteList"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Cancelar" FontSize="14" VerticalAlignment="Center"
                                Click="DeleteCancel_Click"/>
                        <Button x:Name="ConfirmDeleteButton" Style="{StaticResource DangerButton}"
                                Margin="22,0,0,0" Click="ConfirmDelete_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
